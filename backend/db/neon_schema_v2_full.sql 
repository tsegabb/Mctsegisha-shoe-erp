-- =============================================================================
-- INVENTORY / POS SCHEMA v2  (PostgreSQL 15+, Neon, Express.js)
-- =============================================================================
-- FRESH INSTALL ONLY: run on an EMPTY database or a new Neon branch, using the
-- direct (non-pooler) connection string.
-- To upgrade a database that already has data, use neon_upgrade_to_v2.sql.
--
-- This file already INCLUDES these migrations, so do not run them again on a
-- database created from it:
--   001_link_warehouses_to_shops.sql      (warehouses.shop_id + index)
--   002_add_telebirr_cbe_birr_payments.sql (telebirr / cbe_birr payment methods)
--
-- Design rules
--   * Every id is a native uuid. Every timestamp is timestamptz.
--   * Stock lives in ONE place: warehouse_stock. Totals come from the
--     variant_stock / variants_with_stock views.
--   * Every relationship has a foreign key, every foreign key is indexed.
--   * Status / type / role columns are lowercase_snake_case with CHECKs.
--   * Money is numeric(12,2); profit is computed by the database.
--   * No RLS, no Supabase auth objects. Security = least-privilege DB role.
-- =============================================================================

BEGIN;

CREATE EXTENSION IF NOT EXISTS citext;   -- case-insensitive email columns

-- -----------------------------------------------------------------------------
-- Helper: keep updated_at current
-- -----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.set_updated_at()
RETURNS trigger
LANGUAGE plpgsql
AS $fn$
BEGIN
  NEW.updated_at := now();
  RETURN NEW;
END;
$fn$;

-- =============================================================================
-- TABLES
-- =============================================================================

CREATE TABLE shops (
  id         uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  name       text        NOT NULL,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE users (
  id         uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  name       text        NOT NULL,
  email      citext      NOT NULL UNIQUE,            -- case-insensitive unique
  password   text        NOT NULL,                   -- bcrypt/argon2 hash only
  role       text        NOT NULL
             CHECK (role IN ('owner','admin','manager','cashier','staff','warehouse')),
  shop_id    uuid        REFERENCES shops (id) ON DELETE RESTRICT,
  phone      text,
  is_active  boolean     NOT NULL DEFAULT true,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE brands (
  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name        text NOT NULL,
  logo_url    text,
  description text
);

CREATE TABLE categories (
  id          uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  name        text        NOT NULL UNIQUE,
  description text,
  created_at  timestamptz NOT NULL DEFAULT now(),
  updated_at  timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE suppliers (
  id             uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  name           text        NOT NULL,
  contact_person text        NOT NULL,
  email          citext      NOT NULL,
  phone          text        NOT NULL,
  address        text        NOT NULL,
  is_active      boolean     NOT NULL DEFAULT true,
  created_at     timestamptz NOT NULL DEFAULT now(),
  updated_at     timestamptz NOT NULL DEFAULT now()
);

-- shop_id links each warehouse to a shop so "a cashier may only see their own
-- branch" can be enforced. (Included from migration 001.)
CREATE TABLE warehouses (
  id         uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  name       text        NOT NULL,
  code       text        NOT NULL UNIQUE,
  location   text        NOT NULL,
  capacity   integer     NOT NULL CHECK (capacity >= 0),
  is_active  boolean     NOT NULL DEFAULT true,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now(),
  shop_id    uuid        REFERENCES shops (id) ON DELETE SET NULL
);

CREATE TABLE products (
  id          uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
  name        text          NOT NULL,
  description text          NOT NULL,
  brand_id    uuid          NOT NULL REFERENCES brands (id)     ON DELETE RESTRICT,
  category_id uuid          NOT NULL REFERENCES categories (id) ON DELETE RESTRICT,
  gender      text          NOT NULL
              CHECK (gender IN ('men','women','unisex','boys','girls','kids')),
  base_price  numeric(12,2) NOT NULL CHECK (base_price >= 0),   -- default selling price
  cost_price  numeric(12,2) CHECK (cost_price IS NULL OR cost_price >= 0),
  sku         text          UNIQUE,                             -- style / model code
  image_url   text,
  image_urls  jsonb         NOT NULL DEFAULT '[]'::jsonb
              CHECK (jsonb_typeof(image_urls) = 'array'),
  is_active   boolean       NOT NULL DEFAULT true,
  created_at  timestamptz   NOT NULL DEFAULT now(),
  updated_at  timestamptz   NOT NULL DEFAULT now()
);

CREATE TABLE variants (
  id         uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
  product_id uuid          NOT NULL REFERENCES products (id) ON DELETE CASCADE,
  size       text          NOT NULL,
  color      text          NOT NULL,
  sku        text          NOT NULL UNIQUE,
  barcode    text,
  price      numeric(12,2) NOT NULL CHECK (price >= 0),        -- selling price
  is_active  boolean       NOT NULL DEFAULT true,
  created_at timestamptz   NOT NULL DEFAULT now(),
  updated_at timestamptz   NOT NULL DEFAULT now()
);

-- Single source of truth for stock levels
CREATE TABLE warehouse_stock (
  warehouse_id uuid        NOT NULL REFERENCES warehouses (id) ON DELETE RESTRICT,
  variant_id   uuid        NOT NULL REFERENCES variants (id)   ON DELETE CASCADE,
  quantity     integer     NOT NULL DEFAULT 0 CHECK (quantity >= 0),
  updated_at   timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (warehouse_id, variant_id)
);

CREATE TABLE orders (
  id           uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
  supplier_id  uuid          NOT NULL REFERENCES suppliers (id) ON DELETE RESTRICT,
  order_number text          NOT NULL UNIQUE,
  status       text          NOT NULL DEFAULT 'pending'
               CHECK (status IN ('pending','approved','ordered','shipped',
                                 'partially_received','received','completed','cancelled')),
  total_cost   numeric(12,2) NOT NULL CHECK (total_cost >= 0),
  created_at   timestamptz   NOT NULL DEFAULT now(),
  updated_at   timestamptz   NOT NULL DEFAULT now()
);

CREATE TABLE order_items (
  id         uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
  order_id   uuid          NOT NULL REFERENCES orders (id)   ON DELETE CASCADE,
  variant_id uuid          NOT NULL REFERENCES variants (id) ON DELETE RESTRICT,
  quantity   integer       NOT NULL CHECK (quantity > 0),
  unit_cost  numeric(12,2) NOT NULL CHECK (unit_cost >= 0)
);

-- Receipt header: groups several sales lines, records shop and cashier
CREATE TABLE receipts (
  id             uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  receipt_number bigint      GENERATED ALWAYS AS IDENTITY UNIQUE,
  shop_id        uuid        REFERENCES shops (id) ON DELETE RESTRICT,
  cashier_id     uuid        REFERENCES users (id) ON DELETE RESTRICT,
  created_at     timestamptz NOT NULL DEFAULT now()
);

-- One row per sold line item
-- payment_method includes 'telebirr' and 'cbe_birr' (from migration 002).
CREATE TABLE sales (
  id              uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
  receipt_id      uuid          REFERENCES receipts (id)   ON DELETE RESTRICT,
  variant_id      uuid          NOT NULL REFERENCES variants (id)   ON DELETE RESTRICT,
  warehouse_id    uuid          REFERENCES warehouses (id)          ON DELETE RESTRICT,
  quantity        integer       NOT NULL CHECK (quantity > 0),
  selling_price   numeric(12,2) NOT NULL CHECK (selling_price >= 0),
  cost_price      numeric(12,2) NOT NULL CHECK (cost_price >= 0),
  profit          numeric(12,2) GENERATED ALWAYS AS ((selling_price - cost_price) * quantity) STORED,
  payment_method  text          NOT NULL DEFAULT 'cash',
  status          text          NOT NULL DEFAULT 'completed'
                  CHECK (status IN ('completed','partially_returned','returned','refunded','cancelled','voided')),
  returned_qty    integer       NOT NULL DEFAULT 0 CHECK (returned_qty >= 0),
  returned_amount numeric(12,2) NOT NULL DEFAULT 0 CHECK (returned_amount >= 0),
  created_at      timestamptz   NOT NULL DEFAULT now(),
  CONSTRAINT sales_returned_qty_le_qty CHECK (returned_qty <= quantity),
  CONSTRAINT sales_payment_method_check CHECK (
    payment_method IN ('cash','card','mobile_money','bank_transfer','credit','other','telebirr','cbe_birr')
  )
);

CREATE TABLE movements (
  id                uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  variant_id        uuid        NOT NULL REFERENCES variants (id)   ON DELETE RESTRICT,
  from_warehouse_id uuid        REFERENCES warehouses (id)          ON DELETE RESTRICT,
  to_warehouse_id   uuid        REFERENCES warehouses (id)          ON DELETE RESTRICT,
  quantity          integer     NOT NULL CHECK (quantity <> 0),
  type              text        NOT NULL
                    CHECK (type IN ('in','out','transfer','adjustment','sale','return','purchase','damage')),
  reason            text        NOT NULL,
  created_by        text        NOT NULL DEFAULT 'System',
  created_at        timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT movements_shape_chk CHECK (
       (type = 'transfer' AND from_warehouse_id IS NOT NULL
                          AND to_warehouse_id   IS NOT NULL
                          AND from_warehouse_id <> to_warehouse_id)
    OR (type = 'in'  AND to_warehouse_id   IS NOT NULL)
    OR (type = 'out' AND from_warehouse_id IS NOT NULL)
    OR type NOT IN ('transfer','in','out')
  )
);

-- method includes 'telebirr' and 'cbe_birr' (from migration 002).
CREATE TABLE cash_activities (
  id         uuid          PRIMARY KEY DEFAULT gen_random_uuid(),
  shop_id    uuid          REFERENCES shops (id) ON DELETE RESTRICT,
  type       text          NOT NULL
             CHECK (type IN ('income','expense','deposit','withdrawal','sale','refund','opening','closing','adjustment')),
  amount     numeric(12,2) NOT NULL,
  method     text          NOT NULL DEFAULT 'cash',
  note       text,
  user_name  text,
  created_at timestamptz   NOT NULL DEFAULT now(),
  CONSTRAINT cash_activities_method_check CHECK (
    method IN ('cash','card','mobile_money','bank_transfer','credit','other','telebirr','cbe_birr')
  )
);

CREATE TABLE audit_logs (
  id         uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
  action     text        NOT NULL,
  details    jsonb,
  created_by text        DEFAULT 'System',
  created_at timestamptz NOT NULL DEFAULT now()
);

-- =============================================================================
-- INDEXES (Postgres does not index foreign keys automatically)
-- =============================================================================

-- unique business keys
CREATE UNIQUE INDEX brands_name_lower_uq               ON brands (lower(name));
CREATE UNIQUE INDEX variants_product_size_color_uq     ON variants (product_id, size, color); -- also serves variants.product_id FK
CREATE UNIQUE INDEX variants_barcode_uq                ON variants (barcode) WHERE barcode IS NOT NULL;

-- foreign-key / filter indexes
CREATE INDEX users_shop_id_idx             ON users (shop_id)       WHERE shop_id IS NOT NULL;
CREATE INDEX warehouses_shop_id_idx        ON warehouses (shop_id)  WHERE shop_id IS NOT NULL;
CREATE INDEX products_brand_id_idx         ON products (brand_id);
CREATE INDEX products_category_id_idx      ON products (category_id);
CREATE INDEX warehouse_stock_variant_idx   ON warehouse_stock (variant_id);   -- warehouse_id covered by the PK
CREATE INDEX orders_supplier_id_idx        ON orders (supplier_id);
CREATE INDEX orders_status_created_idx     ON orders (status, created_at DESC);
CREATE INDEX order_items_order_id_idx      ON order_items (order_id);
CREATE INDEX order_items_variant_id_idx    ON order_items (variant_id);
CREATE INDEX receipts_shop_created_idx     ON receipts (shop_id, created_at DESC);
CREATE INDEX receipts_cashier_id_idx       ON receipts (cashier_id) WHERE cashier_id IS NOT NULL;
CREATE INDEX sales_receipt_id_idx          ON sales (receipt_id)    WHERE receipt_id IS NOT NULL;
CREATE INDEX sales_created_at_idx          ON sales (created_at DESC);
CREATE INDEX sales_variant_created_idx     ON sales (variant_id, created_at DESC);
CREATE INDEX sales_warehouse_created_idx   ON sales (warehouse_id, created_at DESC) WHERE warehouse_id IS NOT NULL;
CREATE INDEX movements_variant_created_idx ON movements (variant_id, created_at DESC);
CREATE INDEX movements_from_wh_idx         ON movements (from_warehouse_id) WHERE from_warehouse_id IS NOT NULL;
CREATE INDEX movements_to_wh_idx           ON movements (to_warehouse_id)   WHERE to_warehouse_id   IS NOT NULL;
CREATE INDEX cash_activities_shop_created_idx ON cash_activities (shop_id, created_at DESC);
CREATE INDEX audit_logs_created_at_idx     ON audit_logs (created_at DESC);

-- =============================================================================
-- TRIGGERS: maintain updated_at
-- =============================================================================
DO $$
DECLARE t text;
BEGIN
  FOREACH t IN ARRAY ARRAY['shops','users','categories','suppliers','warehouses',
                           'products','variants','warehouse_stock','orders']
  LOOP
    EXECUTE format(
      'CREATE TRIGGER %I BEFORE UPDATE ON public.%I
         FOR EACH ROW EXECUTE FUNCTION public.set_updated_at()',
      t || '_set_updated_at', t);
  END LOOP;
END $$;

-- =============================================================================
-- STOCK VIEWS + SAFE STOCK FUNCTION
-- =============================================================================

-- Total stock per variant (replaces the old variants.current_stock column)
CREATE VIEW variant_stock AS
SELECT v.id AS variant_id,
       COALESCE(SUM(ws.quantity), 0)::integer AS current_stock
FROM variants v
LEFT JOIN warehouse_stock ws ON ws.variant_id = v.id
GROUP BY v.id;

-- Drop-in replacement for "SELECT ... FROM variants" when you need current_stock
CREATE VIEW variants_with_stock AS
SELECT v.*, s.current_stock
FROM variants v
JOIN variant_stock s ON s.variant_id = v.id;

-- Atomic stock change. Positive delta = add, negative = remove.
-- Raises SQLSTATE 23514 ("Insufficient stock") instead of going negative.
-- Call inside your transaction:  SELECT adjust_stock($1, $2, $3);
CREATE OR REPLACE FUNCTION public.adjust_stock(
  p_warehouse_id uuid,
  p_variant_id   uuid,
  p_delta        integer
) RETURNS integer
LANGUAGE plpgsql
AS $fn$
DECLARE
  v_qty integer;
BEGIN
  UPDATE public.warehouse_stock
     SET quantity = quantity + p_delta
   WHERE warehouse_id = p_warehouse_id AND variant_id = p_variant_id
  RETURNING quantity INTO v_qty;

  IF NOT FOUND THEN
    IF p_delta < 0 THEN
      RAISE EXCEPTION 'Insufficient stock' USING ERRCODE = '23514';
    END IF;
    INSERT INTO public.warehouse_stock (warehouse_id, variant_id, quantity)
    VALUES (p_warehouse_id, p_variant_id, p_delta)
    ON CONFLICT (warehouse_id, variant_id)
    DO UPDATE SET quantity = public.warehouse_stock.quantity + EXCLUDED.quantity
    RETURNING quantity INTO v_qty;
  END IF;

  RETURN v_qty;
END;
$fn$;

COMMIT;

