# Copy to .env (never commit .env, and never put real secrets in this file)
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://app_rw:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
JWT_SECRET=                      # openssl rand -hex 48
JWT_EXPIRES_IN=8h
CORS_ORIGINS=                    # e.g. https://soleflow.app (empty = same-origin only in production)
APP_URL=https://soleflow.app
APP_TIMEZONE=Africa/Addis_Ababa
DATA_DIR=backend/data
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_ALERT_EMAIL=
SMTP_PASS=
