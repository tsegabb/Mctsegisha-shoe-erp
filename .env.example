# Environment & Port (Render/Cloud Run dynamically injects PORT)
NODE_ENV=production
PORT=3000

# APP_URL: The URL where this applet is hosted (e.g., https://soleflow.app)
APP_URL=https://soleflow.app

# DATABASE_URL: PostgreSQL connection string targeting Neon DB.
# Use the app_rw role from schema for least-privilege production access:
# E.g., postgresql://app_rw:[PASSWORD]@ep-holy-bar-b8r20gbn-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://app_rw:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=10
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT_SECRET: Secret key for signing HS256 JWT tokens (minimum 32 characters, e.g., openssl rand -hex 48)
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_JWT_SECRET_STRING_RANDOM_HEX

JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
CORS_ORIGINS=

# Application Timezone & Data Directory
APP_TIMEZONE=Africa/Addis_Ababa
DATA_DIR=backend/data

# Optional Integration Secrets (masked in API responses)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_ALERT_EMAIL=
SMTP_PASS=
